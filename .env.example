# Referencia de configuracao: este arquivo NAO e carregado automaticamente.
# Configure as variaveis no processo que inicia o backend/frontend.
# Nunca versione uma senha real. Os scripts podem solicita-la de forma oculta.
DB_URL=jdbc:postgresql://localhost:5432/roboparts
DB_USERNAME=postgres
DB_PASSWORD=
# Codigo inicial exclusivo do responsavel (24 a 256 caracteres).
# Os demais funcionarios precisam de convite individual criado em Seguranca.
REGISTRATION_REQUIRE_INVITATION=true
SECURITY_MANAGERS=
REGISTRATION_ACCESS_CODE=
# Gmail: use uma senha de app, criada com verificacao em duas etapas ativada.
# Start-Backend.ps1 -ConfigureEmail pede estes valores localmente sem grava-los.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_DOCS_ENABLED=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TIMEOUT=8h
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_CAPACITY=4096
AUTH_ACCOUNT_MAX_ATTEMPTS=5
AUTH_ACCOUNT_WINDOW_SECONDS=900
AUTH_ACCOUNT_CAPACITY=4096
# Configurar-Seguranca.cmd prepara contas restritas e chave privada fora do projeto.
# DB_AUTO_MIGRATE=false
# SECURITY_KEY_FILE=

# Publicacao: ative o perfil prod somente apos configurar dominio HTTPS/proxy.
# SPRING_PROFILES_ACTIVE=prod
# APP_CORS_ALLOWED_ORIGINS=https://roboparts.sua-equipe.example
# SESSION_TIMEOUT=30m
# O perfil prod exige cookie seguro e documentacao desativada.
# Remova as opcoes locais API_DOCS_ENABLED=true e SESSION_COOKIE_SECURE=false acima.
# O proxy confiavel deve remover headers Forwarded/X-Forwarded-* do cliente.

# Frontend: vazio usa /api e o proxy local do Vite.
# Variaveis VITE_* sao publicas; nunca coloque segredos nelas.
VITE_API_BASE_URL=
