# Referencia para a hospedagem: nao e carregado automaticamente e nao contem segredos.
# Defina os valores reais no ambiente/gerenciador de segredos do servidor.
SPRING_PROFILES_ACTIVE=prod
DEBUG=false
TRACE=false
APP_CORS_ALLOWED_ORIGINS=https://roboparts.sua-equipe.example
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5432/roboparts
DB_USERNAME=roboparts_app
DB_PASSWORD=
DB_AUTO_MIGRATE=false
# Aplique atualizacoes usando a conta administrativa somente no processo offline.
SECURITY_MANAGERS=
# Base64 de 32 bytes aleatorios. Guarde a mesma chave no gerenciador de segredos e nos backups.
SECURITY_ENCRYPTION_KEY=
REGISTRATION_REQUIRE_INVITATION=true
REGISTRATION_ACCESS_CODE=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
API_DOCS_ENABLED=false
# Vazio pressupoe frontend e API publicados no mesmo dominio, por meio de /api.
VITE_API_BASE_URL=
